# Auto-detect text files and normalize line endings to LF
* text=auto
# Explicitly mark binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.svg text
*.ico binary
*.cur binary
*.crs binary
*.flac binary
*.iso binary
*.tcz binary
*.bin binary
*.pdf binary
*.zip binary
*.tar.gz binary
# Source code - always LF
*.js text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.txt text eol=lf
# Lock files
package-lock.json text eol=lf
# Blank context lines in source patches intentionally contain one space.
utilities-src/local-assistant-runtime/patches/*.patch -whitespace
