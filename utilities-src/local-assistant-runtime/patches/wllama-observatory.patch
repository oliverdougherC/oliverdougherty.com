+  static bool observe_layer_summary(ggml_tensor * tensor, bool ask, void * data)
+  {
+    if (std::string(ggml_get_name(tensor)) != "observatory_layer_mean_squares") return false;
+    auto * self = static_cast<wllama_context *>(data);
+    if (!self->ctx || !self->vocab) return false; // native warmup has no conversation
+    if (ask) return true;
+    const int layers = llama_model_n_layer(self->model);
+    char interval_text[32] = {};
+    llama_model_meta_val_str(self->model, "qwen35.full_attention_interval", interval_text, sizeof(interval_text));
+    const int interval = atoi(interval_text);
+    GGML_ASSERT(interval > 0);
+    std::vector<int> attention_layers;
+    for (int i = 0; i < layers; ++i) if ((i + 1) % interval == 0) attention_layers.push_back(i);
+    const size_t expected = layers * 3 + attention_layers.size() * 32 + (self->observatory_lens_enabled ? 20 : 0);
+    GGML_ASSERT(tensor->type == GGML_TYPE_F32 && ggml_nelements(tensor) == (int64_t) expected);
+    std::vector<float> values(expected);
+    ggml_backend_tensor_get(tensor, values.data(), 0, expected * sizeof(float));
+    const std::string backend = ggml_backend_buft_name(ggml_backend_buffer_get_type(tensor->buffer));
+    if (self->observatory_backend != backend) {
+      self->observatory_backend = backend;
+      LOG_INF("observatory: reduced summaries in %s buffer (%lld bytes)\n", backend.c_str(), (long long) (expected * sizeof(float)));
+    }
+    json packet = {{"layers", json::array()}, {"layer_changes", json::array()},
+                   {"attention", json::array()}, {"lens", json::array()},
+                   {"pass", ++self->observatory_pass}, {"layer_backend", backend}};
+    auto rms = [&](size_t index) { return std::sqrt(std::max(0.0f, values[index])); };
+    for (int i = 0; i < layers; ++i) {
+      const float input = rms(i * 3 + 1), delta = rms(i * 3 + 2);
+      packet["layers"].push_back({{"layer", i}, {"rms", rms(i * 3)}});
+      packet["layer_changes"].push_back({{"layer", i}, {"input_rms", input}, {"delta_rms", delta}, {"relative_delta", delta / std::max(input, 1e-12f)}});
+    }
+    auto * hybrid = dynamic_cast<llama_memory_hybrid *>(llama_get_memory(self->ctx));
+    GGML_ASSERT(hybrid != nullptr);
+    const auto & cells = hybrid->get_mem_attn()->get_cells(0);
+    const auto query = cells.seq_pos_max(0);
+    size_t offset = layers * 3;
+    for (int layer : attention_layers) {
+      json entries = json::array();
+      double coverage = 0;
+      for (int i = 0; i < 16; ++i) {
+        const int index = (int) values[offset + i];
+        const float weight = values[offset + 16 + i];
+        if (weight <= 0 || index < 0 || index >= (int) cells.size() || !cells.seq_has(index, 0)) continue;
+        const auto position = cells.pos_get(index);
+        GGML_ASSERT(position >= 0 && position <= query);
+        entries.push_back({{"position", position}, {"weight", weight}});
+        coverage += weight;
+      }
+      packet["attention"].push_back({{"layer", layer}, {"query_position", query},
+        {"key_count", cells.seq_pos_get(0).size()}, {"head_count", llama_model_n_head(self->model)},
+        {"entries", std::move(entries)}, {"coverage", coverage}});
+      offset += 32;
+    }
+    if (self->observatory_lens_enabled) {
+      for (int layer : {layers / 2 - 1, layers * 5 / 6 - 1}) {
+        json candidates = json::array();
+        for (int i = 0; i < 5; ++i) {
+          const llama_token id = (llama_token) values[offset + i];
+          GGML_ASSERT(id >= 0 && id < llama_vocab_n_tokens(self->vocab));
+          candidates.push_back({{"id", id}, {"piece", common_token_to_piece(self->vocab, id, true)}, {"probability", values[offset + 5 + i]}});
+        }
+        packet["lens"].push_back({{"layer", layer}, {"candidates", std::move(candidates)}});
+        offset += 10;
+      }
+    }
+    self->observatory_packet = std::move(packet);
+    return true;
+  }
