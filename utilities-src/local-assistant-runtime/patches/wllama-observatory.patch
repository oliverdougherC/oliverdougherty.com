+      auto result = rd.next(should_stop);
+      if (result && result->is_error()) throw app_exception("Could not reset model context");
+    }
+    llama_memory_clear(llama_get_memory(ctx), true);
+    observatory_prompt_tokens = json::array();
+    observatory_packet = json::object();
+    observatory_pass = observatory_sent_pass = 0;
+    glue_msg_observe_reset_res res;
+    res.success.value = true;
+    return res;
+  }
